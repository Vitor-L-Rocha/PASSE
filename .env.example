# O Node não carrega .env automaticamente. Ex.: node --env-file=.env src/server.js
# Não versionar .env nem chaves. Nunca exponha credenciais no frontend.
# Vazio: tmdata quando o índice é válido; demo somente se indisponível.
# Para exigir só dados reais, defina tmdata explicitamente (não há fallback).
PASSE_PROVIDERS=
# Mesmo diretório para sync e servidor, relativo à raiz do projeto (ou absoluto).
PASSE_TMDATA_DIR=.cache/tmdata
# CSVs gzip públicos do README de transfermarkt-datasets; não é o site Transfermarkt.
PASSE_TMDATA_URL=https://pub-e682421888d945d684bcae8890b0ec20.r2.dev/data/

# Cache JSON em .cache/providers/ (ignorado pelo Git), TTL em milissegundos.
# Contém dados do fornecedor: ajuste o TTL às permissões do seu contrato.
PASSE_CACHE_TTL_MS=3600000
PASSE_PROVIDER_TIMEOUT_MS=10000

# TRANSFERMARKT: instância privada/autorizada de felipeall/transfermarkt-api v4.
# Sem URL, catálogo, temporada e confirmação de direitos: isEnabled=false.
# Self-hosting/licença MIT do código NÃO concede licença sobre os dados.
# Só marque true após conferir termos, robots e obter autorização aplicável.
# Não aponte ao site Transfermarkt nem use um proxy para contornar bloqueios.
PASSE_TRANSFERMARKT_AUTHORIZED=false
PASSE_TRANSFERMARKT_URL=
PASSE_TRANSFERMARKT_TOKEN=
# ISO-2 do país da LIGA na temporada selecionada, nunca da nacionalidade.
# Catálogo é de clubes; competitionId identifica a liga no transfermarkt-api.
PASSE_TRANSFERMARKT_CLUBS=[]
# Exemplo: [{"id":"123","name":"Clube autorizado","league":"Liga","country":"BR","competitionId":"BRA1"}]
PASSE_TRANSFERMARKT_SEASON=2026
PASSE_TRANSFERMARKT_INTERVAL_MS=1500
# Opcional: uma chamada /players/{id}/stats por jogador filtrado. Aumenta latência.
# Filtra a temporada, clube e competição antes de converter gols/assistências por 90.
# false => busca sem stats; o núcleo só deriva características quando há dados.
# getPlayer sempre tenta stats/histórico + conquistas e foto (opcionais).
PASSE_TRANSFERMARKT_INCLUDE_STATS=false

# API-FOOTBALL / API-SPORTS v3: DADOS RECENTES (recomendado)
# 1. Crie a conta grátis em https://dashboard.api-football.com e copie a chave.
# 2. Cole abaixo e rode: npm run sync-apifootball -- --check   (confere plano e temporada atual)
# 3. Depois: npm run sync-apifootball   (repita por alguns dias; respeita a cota de 100/dia)
# Atualiza clube atual, minutos, estatísticas e nota da temporada corrente dos jogadores
# do índice, libera mais características e traz os títulos na ficha.
PASSE_API_FOOTBALL_KEY=
# Ligas a atualizar (códigos do índice). Ex.: BRA1,ARG1,PO1,ES1. Brasileirão ~30 consultas.
PASSE_API_FOOTBALL_SYNC_LEAGUES=BRA1
# Máximo de consultas por execução (o plano grátis tem 100/dia; 10 ficam para títulos).
PASSE_API_FOOTBALL_DAILY_BUDGET=80

# Uso como FONTE PRÓPRIA de busca (opcional, avançado): PASSE_PROVIDERS=tmdata,api-football
# Sem catálogo e temporada válidos: isEnabled=false.
PASSE_API_FOOTBALL_URL=https://v3.football.api-sports.io/
PASSE_API_FOOTBALL_LEAGUES=[]
# Exemplo de catálogo: [{"id":"71","name":"Serie A","country":"BR"}]
PASSE_API_FOOTBALL_SEASON=2026
PASSE_API_FOOTBALL_INTERVAL_MS=6500
PASSE_API_FOOTBALL_MAX_PAGES=10
# A API não informa valor de mercado e dá posições amplas para jogadores de linha.
# Metadados opcionais, curados/licenciados, por ID API-Football. Não são estimativas.
# Sem valor: excluído de busca com orçamento; sem posição específica: não listado.
# Goleiros são reconhecidos automaticamente. foot/contractUntil são opcionais.
PASSE_API_FOOTBALL_METADATA={}
# Exemplo de formato (IDs/valores fictícios): {"123":{"position":"CB","marketValueEur":1000000,"foot":"right","contractUntil":"2027-12-31"}}

# SOFASCORE: feed/adaptador AUTORIZADO, com licença/acordo sobre os dados.
# Não é a API interna do site: contrato completo em src/providers/SOFASCORE_FEED.md.
# Sem URL + autorização explícita, isEnabled=false. Token depende do contrato.
# Não configurar um proxy para contornar 403; não há spoofing/headless/retry.
# Ex.: PASSE_PROVIDERS=demo,transfermarkt,api-football,sofascore
PASSE_SOFASCORE_AUTHORIZED=false
PASSE_SOFASCORE_URL=
PASSE_SOFASCORE_TOKEN=
PASSE_SOFASCORE_INTERVAL_MS=1500
PASSE_SOFASCORE_MAX_PAGES=10
# IDs/tipos definidos PELO SEU FEED para códigos de src/data/characteristics.js.
# Não existe enumeração numérica pública presumida pelo PASSE.
PASSE_SOFASCORE_TYPE_MAP={}
# Exemplo de formato, IDs fictícios: {"101":"finalizacao","205":"desarme"}
# Associação EXPLÍCITA para enriquecer fonte externa (nunca matching pelo nome).
PASSE_SOFASCORE_PLAYER_IDS={}
# Exemplo fictício: {"tmdata-7":"123","transfermarkt-7":"123","api-football-9":"123"}
# Cada ID precisa ser associado; tmdata-7 não herda o mapa de transfermarkt-7.
