{
  "name": "passe",
  "version": "1.0.0",
  "description": "PASSE - Plataforma de Auxílio ao Scouting para Sociedades Esportivas",
  "main": "src/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "sync-data": "node scripts/sync-data.js",
    "prestart": "node scripts/sync-data.js --if-missing",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --import ./test/setup.js --test test/",
    "sync-apifootball": "node --env-file-if-exists=.env scripts/sync-apifootball.js",
    "sync-goalapi": "node --env-file-if-exists=.env scripts/sync-goalapi.js",
    "sync-reep": "node scripts/sync-reep.js",
    "sync-salimt": "node scripts/sync-salimt.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vitor-L-Rocha/PASSE.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Vitor-L-Rocha/PASSE/issues"
  },
  "homepage": "https://github.com/Vitor-L-Rocha/PASSE#readme",
  "dependencies": {
    "express": "^4.22.3"
  },
  "engines": {
    "node": ">=22.9"
  }
}
